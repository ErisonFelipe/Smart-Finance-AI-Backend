generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  password      String
  monthlyIncome Float         @default(0)  
  transactions  Transaction[]
  debts         Debt[]
  boletos       Boleto[]
  categories    Category[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Category {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  icon         String        @default("tag")
  type         String
  isDefault    Boolean       @default(false)
  transactions Transaction[]
  debts        Debt[]

  @@unique([userId, name, type])
}

model Transaction {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId         String
  category           Category  @relation(fields: [categoryId], references: [id])
  type               String
  amount             Float
  description        String
  dueDate            DateTime
  paymentDate        DateTime?
  recurrence         String    @default("none")
  installments       Int       @default(1)
  currentInstallment Int       @default(1)
  paid               Boolean   @default(false)
  createdAt          DateTime  @default(now())
}

model Debt {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  name            String
  totalAmount     Float
  paidAmount      Float         @default(0)
  startDate       DateTime
  installments    Int
  status          String        @default("active")
  installmentList Installment[]
  createdAt       DateTime      @default(now())
}

model Installment {
  id      String   @id @default(uuid())
  debtId  String
  debt    Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  number  Int
  amount  Float
  dueDate DateTime
  paid    Boolean  @default(false)
}

model Boleto {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  barcode     String?
  amount      Float
  dueDate     DateTime
  paid        Boolean  @default(false)
  description String
  createdAt   DateTime @default(now())
}