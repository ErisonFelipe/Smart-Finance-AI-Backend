generator client {
    provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  password      String
  monthlyIncome Float         @default(0)
  payDay        Int           @default(1)
  photoUrl      String?       // URL da foto de perfil
  transactions  Transaction[]
  debts         Debt[]
  boletos       Boleto[]
  categories    Category[]
  goals         Goal[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  }

model Category {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  icon         String        @default("tag")
  type         String        // income | expense | investment
  isDefault    Boolean       @default(false)
  transactions Transaction[]
  debts        Debt[]

  @@unique([userId, name, type])
  @@index([userId])
}

model Transaction {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId         String
  category           Category  @relation(fields: [categoryId], references: [id])
  type               String    // income | expense | investment
  amount             Float
  description        String
  dueDate            DateTime
  paymentDate        DateTime?
  recurrence         String    @default("none")
  installments       Int       @default(1)
  currentInstallment Int       @default(1)
  paid               Boolean   @default(false)
  createdAt          DateTime  @default(now())

  @@index([userId, dueDate])
  @@index([categoryId])
}

model Debt {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  name            String
  totalAmount     Float
  paidAmount      Float         @default(0)
  startDate       DateTime
  installments    Int
  status          String        @default("active") // active | finished | late
  installmentList Installment[]
  createdAt       DateTime      @default(now())

  @@index([userId])
}

model Installment {
  id      String   @id @default(uuid())
  debtId  String
  debt    Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  number  Int
  amount  Float
  dueDate DateTime
  paid    Boolean  @default(false)

  @@index([debtId])
}

model Boleto {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  barcode     String?
  amount      Float
  dueDate     DateTime
  paid        Boolean  @default(false)
  description String
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Goal {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  deadline      DateTime?
  color         String    @default("#059669")
  icon          String    @default("target")
  status        String    @default("active") // active | completed | cancelled
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}